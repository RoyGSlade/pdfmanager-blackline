{
  "name": "pdfmanager-blackline",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first browser PDF workbench for safe edits and verified copy export.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "lucide-react": "^0.546.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "7.0.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "^0.2.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "fflate": "^0.8.3",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
